{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "SentinelX Prometheus data source",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "SentinelX Security Operations",
  "uid": "sentinelx-secops",
  "tags": ["sentinelx", "security"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Active Agents",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sentinelx_agents{status=\"active\"}", "legendFormat": "active" }
      ]
    },
    {
      "id": 2,
      "title": "Open Alerts",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } } },
      "targets": [
        { "expr": "sum(sentinelx_open_alerts)", "legendFormat": "open" }
      ]
    },
    {
      "id": 3,
      "title": "Blocked Events",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "expr": "sentinelx_security_events_total{decision=\"BLOCK\"}", "legendFormat": "blocked" }
      ]
    },
    {
      "id": 4,
      "title": "Open Incidents",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "expr": "sum(sentinelx_incidents) - sum(sentinelx_incidents{status=~\"RESOLVED|CLOSED\"})", "legendFormat": "open" }
      ]
    },
    {
      "id": 5,
      "title": "Enforcement Decisions",
      "type": "piechart",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "expr": "sentinelx_security_events_total", "legendFormat": "{{decision}}" }
      ]
    },
    {
      "id": 6,
      "title": "Open Alerts by Severity",
      "type": "bargauge",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "sentinelx_open_alerts", "legendFormat": "{{severity}}" }
      ]
    },
    {
      "id": 7,
      "title": "Agents (status) over time",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 13 },
      "targets": [
        { "expr": "sentinelx_agents", "legendFormat": "{{status}}" }
      ]
    }
  ]
}
